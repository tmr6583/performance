# ── API Olist (Tiny v3) ────────────────────────────────────────────────────
CLIENT_ID=seu_client_id_aqui
CLIENT_SECRET=seu_client_secret_aqui
OLIST_REDIRECT_URI=https://betinalimpeza.ddns.net/performance/api/olist/callback

# TOKEN_FILE — opcional: compartilhar tokens com outro projeto
# TOKEN_FILE=/opt/betina/atrasados/.tiny_tokens.json

# ── SMTP (SSL/TLS porta 465) ───────────────────────────────────────────────
SMTP_HOST=email-ssl.com.br
SMTP_PORT=465
SMTP_USER=contato@betinalimpeza.com.br
SMTP_PASSWORD=sua_senha_aqui
EMAIL_FROM_NAME=Betina Limpeza

# ── Banco de dados ─────────────────────────────────────────────────────────
