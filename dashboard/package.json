{
  "name": "performance-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node -e \"require('fs').cpSync('.next/static', '.next/standalone/dashboard/.next/static', {recursive: true})\"",
    "start": "cross-env NODE_ENV=production node server.mjs",
    "start:optimized": "cross-env-shell NODE_ENV=production APP_ENABLE_CLUSTER=0 APP_WORKERS=1 NODE_OPTIONS=\"--max-old-space-size=192 --expose-gc\" \"node server.mjs\"",
    "start:cluster": "cross-env NODE_ENV=production APP_ENABLE_CLUSTER=1 node server.mjs",
    "start:pm2": "pm2 start ecosystem.config.mjs --env production",
    "start:unified": "node unified-server.mjs",
    "lint": "eslint"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "next": "16.2.1",
    "node-cron": "^3.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
